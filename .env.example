# Copy this file to .env before using Docker Compose. Do not commit .env.
# The database URL uses the Compose-internal postgres hostname; keep its
# credentials aligned with the PostgreSQL variables below.
DEVSUPPORT_POSTGRES_DB=devsupport
DEVSUPPORT_POSTGRES_USER=devsupport
DEVSUPPORT_POSTGRES_PASSWORD=replace-with-a-unique-long-password
DEVSUPPORT_DATABASE_URL=postgresql+psycopg://devsupport:replace-with-a-unique-long-password@postgres:5432/devsupport

# Host exposure defaults to localhost. Set the web bind address only to a
# trusted intranet/VPN interface; never expose an unauthenticated instance publicly.
DEVSUPPORT_WEB_BIND_ADDRESS=127.0.0.1
DEVSUPPORT_WEB_PORT=3000
DEVSUPPORT_BACKEND_BIND_ADDRESS=127.0.0.1
DEVSUPPORT_BACKEND_PORT=8002

# The browser calls /api and the Next.js container proxies it internally.
NEXT_PUBLIC_DEVSUPPORT_API_BASE_URL=/api
DEVSUPPORT_BACKEND_API_URL=http://backend:8000
DEVSUPPORT_APP_ENVIRONMENT=trusted-local

# OpenAI-compatible LLM configuration. Leave model/key blank only when the
# deployment is not expected to start an investigation.
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=50
LLM_THINKING_MODE=

# OpenAI-compatible embedding configuration.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# Legacy fixed Fault Lab endpoints are optional and only for local development.
DEVSUPPORT_FAULT_LAB_ORDER_SERVICE_URL=http://host.docker.internal:8000
DEVSUPPORT_FAULT_LAB_PAYMENT_SERVICE_URL=http://host.docker.internal:8001
DEVSUPPORT_RUNTIME_EVIDENCE_PROVIDER=fault_lab
DEVSUPPORT_OPENSEARCH_URL=
DEVSUPPORT_PROMETHEUS_URL=

# JSON deployment configuration. Keep provider references opaque. Put endpoint
# and credential values only in DEVSUPPORT_PROVIDER_BACKEND_CONFIGS.
DEVSUPPORT_INVESTIGATION_TARGET_CONFIGS=[]
DEVSUPPORT_PROVIDER_CONFIGS=[]
DEVSUPPORT_PROVIDER_BACKEND_CONFIGS=[]
